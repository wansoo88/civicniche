# --- LLM (정규화·경계분류·반복비 실측) ---
# 없으면 모든 LLM 단계가 결정적 mock으로 폴백되어 비용 0으로 동작합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# 종량 예산 캡(USD) — measure/pipeline가 이 값을 넘으면 경고/중단 (§3.2)
LLM_MONTHLY_BUDGET_USD=30

# --- 데이터 소스 ---
# 한국 공공데이터포털 OpenAPI 인증키 (https://www.data.go.kr) — 없으면 OSM/샘플만 사용
DATA_GO_KR_KEY=
# OSM Overpass 엔드포인트 (기본 공개 인스턴스)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- 색인/배포 ---
INDEXNOW_KEY=
SITE_URL=https://example.com

# --- 결제 (MoR) — 데이터 셀프판매 가동 시 (§13-A 선검증 후) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# === 수익화 (프로필 A: 최대 자동화 / 영업 0) — 사이트 PUBLIC 노출 변수 ===
# ① 데이터 셀프판매 결제 링크(MoR) — 핵심 패시브 수익원(트래픽 무관)
PUBLIC_DATASALE_URL=
# ③ 디스플레이 광고(AdSense) — 트래픽 규모 시 의미화
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=
# (② 문맥 제휴 링크는 packages/site/monetization.config.mjs 에서 설정)

# 참고: 스폰서/리드 콜드아웃리치(OUTREACH_*)는 프로필 A에서 비활성(수동 영업 → 무인 원칙과 충돌).
